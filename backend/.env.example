# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb://localhost:27017/impactiq
JWT_SECRET=your_jwt_secret_here

# ──────────────────────────────────────────────
# AI Inference Provider Selection
# ──────────────────────────────────────────────
# Supported: "nebius" (Nebius Token Factory) or "nvidia" (NVIDIA NIM)
AI_PROVIDER=nebius

# ──────────────────────────────────────────────
# Nebius Token Factory Inference
# ──────────────────────────────────────────────
# Official endpoint: https://api.tokenfactory.nebius.com/v1
# Verified eligible NVIDIA open-source model: nvidia/nemotron-3-super-120b-a12b
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# ──────────────────────────────────────────────
# NVIDIA NIM Inference (preserved provider)
# ──────────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ──────────────────────────────────────────────
# Python Agent Service
# ──────────────────────────────────────────────
PYTHON_AGENT_URL=http://localhost:8000
AGENT_API_KEY=your_agent_api_key_here

# ──────────────────────────────────────────────
# GitHub Integration
# ──────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ──────────────────────────────────────────────
# Email (Nodemailer)
# ──────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# ──────────────────────────────────────────────
# Deprecated (Gemini — no longer used)
# ──────────────────────────────────────────────
# GEMINI_API_KEY=  # replaced by NVIDIA_API_KEY
# GEMINI_MODEL=    # replaced by NVIDIA_MODEL
